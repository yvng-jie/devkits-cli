{
  "name": "devkits-cli",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.2",
  "description": "Developer tools that never leave your terminal — decode JWTs, hash, Base64, colors and cron. Offline, pipe-friendly, --json everywhere.",
  "type": "module",
  "bin": {
    "devkits-cli": "./dist/index.js",
    "dt": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "dt",
    "dt-cli",
    "devkits",
    "jwt",
    "jwt-decode",
    "jwt-verify",
    "hash",
    "hmac",
    "base64",
    "color-converter",
    "cron",
    "timestamp",
    "offline",
    "privacy",
    "no-network",
    "developer-tools",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yvng-jie/devkits-cli"
  },
  "homepage": "https://github.com/yvng-jie/devkits-cli#readme",
  "bugs": {
    "url": "https://github.com/yvng-jie/devkits-cli/issues"
  },
  "license": "MIT",
  "author": "yangfree",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  }
}
